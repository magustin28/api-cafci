# ─────────────────────────────────────────────────────────────
#  Variables de entorno de cafci-api
#
#  Uso local:  copiar este archivo a .env y completar los valores
#              (en Windows:  copy .env.example .env)
#
#  En Render:  el .env NO se sube al repo. Las variables se cargan en
#              el panel → servicio api-cafci → Environment → Add Environment Variable
# ─────────────────────────────────────────────────────────────

# URL del proyecto de Supabase (Settings → API → Project URL)
SUPABASE_URL=https://<proyecto>.supabase.co

# Clave SECRETA de Supabase. ⚠️ NO es la clave publishable: saltea las políticas
# RLS, así que sólo puede vivir en componentes de backend.
#
# Convención de claves (recomendación de Supabase: una clave secreta por componente,
# así si una se filtra se revoca sólo esa):
#   - `api-render`  → Render → Environment (nunca en el repo ni en Drive)
#   - `local-dev`   → este .env (la única que puede estar en tu máquina)
# Este archivo NO debe contener nunca la clave que usa producción.
# Administración: Supabase → Project Settings → API Keys (crear / revocar / rotar).
SUPABASE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Puerto HTTP local. En Render es opcional: la plataforma inyecta PORT (default 10000).
PORT=3000
